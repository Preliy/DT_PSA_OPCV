# Line endings are normalised to LF in the repository AND in the working tree.
#
# `eol=lf` rather than a bare `text=auto` on purpose. With native checkout a tracked file
# is CRLF on Windows and LF on Linux, so the same file has two different byte sequences
# depending on who looked at it - and _docs/context/.machine.json is compared by content
# across repositories: each vendor module commits a copy of it, and the compatibility
# check reads the main repo's copy against what raw.githubusercontent.com serves. A
# platform-dependent checkout makes that comparison answer differently on every machine.
* text=auto eol=lf

# Unity YAML assets and their metas. A .meta carries the GUID every scene reference
# resolves through, so a rewritten one breaks serialized links silently.
*.meta      text eol=lf
*.asmdef    text eol=lf
*.asset     text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf

*.cs        text eol=lf diff=csharp
*.py        text eol=lf diff=python
*.json      text eol=lf
*.md        text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binaries git must never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.fbx       binary
*.dll       binary
*.so        binary
*.pdf       binary
*.unitypackage binary

# The machine description is generated. Marking it keeps a diff of a regenerated page
# out of the way of the review, without hiding it from git.
_docs/context/** linguist-generated=true
