  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: VERTICAL axis for arm 1, despite the X in the name. Max is raised, and
      arm 1 stays there for the whole cycle; min is only the power-on rest position.
      Arm 2 names its axes the opposite way round.
  - key: oc.plcPath
    value: MAIN.FG_03.Y_AxisX1
  - key: oc.deviceType
    value: Cylinder
  - key: Signal
    value: Double solenoid with both limits read. MAX is raised; arm 1 rises once
      and stays up for the whole cycle.
  _topologySegment: 
  _topologyParent: {fileID: 0}
