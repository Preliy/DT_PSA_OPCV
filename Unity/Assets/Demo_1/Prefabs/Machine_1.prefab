  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: Destroys pallets at the end of the return run, closing the circulation.
  - key: Twin
    value: OC Sink (a Detector) with Delete(). Removes any payload that reaches it.
  - key: Approximation
    value: Parts are destroyed rather than unloaded, so nothing downstream of FG_05
      is modelled and no PLC signal marks a finished part leaving the cell.
  _topologySegment: 
  _topologyParent: {fileID: 0}
