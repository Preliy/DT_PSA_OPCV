  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: Writes the LaserMark datum onto the payload under the laser.
  - key: Twin
    value: OC DataReader on a Rigidbody - despite the name it both reads and writes,
      via Read() and Write(float). Keyed by _key, which here is LaserMark.
  - key: Caution
    value: FG_01 WRITES LaserMark here but READS SerialNumber with its camera. It
      never verifies its own mark - FG_02 is what reads LaserMark back.
  _topologySegment: 
  _topologyParent: {fileID: 0}
