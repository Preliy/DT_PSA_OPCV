  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Pneumatic window in front of P_Reader, doubling as the camera shield.
      Closed while the laser fires, opened for the read.
  - key: oc.plcPath
    value: MAIN.FG_01.Y_ReaderWindow
  - key: oc.deviceType
    value: Cylinder
  - key: Signal
    value: Double solenoid with both limits read. EXTENDED opens the window for the
      read; retracted shields the optics and is home.
  _topologySegment: 
  _topologyParent: {fileID: 0}
