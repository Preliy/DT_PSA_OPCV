  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Rotates arm 1 through 180 degrees. Retracted (0 deg) is home and the receiving
      orientation; extended (180 deg) is the placing one. The flip is also what lowers
      the part into slot 2.
  - key: oc.plcPath
    value: MAIN.FG_03.Y_AxisR1
  - key: oc.deviceType
    value: Cylinder
  - key: Signal
    value: Double solenoid with both limits read. Rotary. Retracted is 0 deg and
      the receiving orientation; extended is 180 deg and the placing one.
  _topologySegment: 
  _topologyParent: {fileID: 0}
