  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: The driven belt surface of a straight conveyor section.
  - key: Twin
    value: TransportLinear on a Rigidbody, from TU Linear Typ 1. Moves any rigidbody
      resting on it by surface velocity.
  - key: Approximation
    value: No friction, no slip and no accumulation pressure. A pallet held by a
      stopper simply stops while the surface keeps commanding motion.
  _topologySegment: 
  _topologyParent: {fileID: 0}
