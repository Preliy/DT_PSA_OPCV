  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Conveyor drive for a straight transport section. Runs continuously while
      SIL is enabled.
  - key: Signal
    value: Simple drive, forward and backward run bits out, one drive-active bit
      back. No speed reference and no encoder.
