  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: The cap feed belt, running continuously to push caps up to the pick position.
  - key: Twin
    value: TransportLinear on a Rigidbody, from the Source Unit Caps prefab.
  - key: Caution
    value: The feed is NOT part of the pallet cycle. It is commanded on mode and
      state only; driven from a station sequence it would stop between pallets and
      no cap would ever be waiting.
  _topologySegment: 
  _topologyParent: {fileID: 0}
