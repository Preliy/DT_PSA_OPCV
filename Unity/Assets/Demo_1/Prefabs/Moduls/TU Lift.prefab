--- !u!114 &3177597812995233823
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7169684665027026121}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Vertical transfer between the two conveyor levels. Takes a pallet on its
      own short conveyor, moves it to the other level and hands it on.
  - key: PlcTree
    value: Carries an OC Hierarchy with IsNameSampler set, so it does NOT open a
      level in the PLC path. It prefixes its children instead, joined with an underscore
      - hence MAIN.FG_Transport.Lift01_B_Detect rather than MAIN.FG_Transport.Lift01.B_Detect.
      FG_Transport therefore stays flat in the PLC project.
  _topologySegment: 
  _topologyParent: {fileID: 0}
