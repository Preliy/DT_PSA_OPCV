  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Pilar.Context::Pilar.Context.ContextNode
  _entries:
  - key: Function
    value: Lift cylinder. Drives the carriage between the lower and upper conveyor
      levels.
  - key: Signal
    value: Double solenoid with both limits read. Moves the carriage between the
      lower and upper conveyor levels.
  - key: Caution
    value: The carriage belt may only run while this is AT a level. Between levels
