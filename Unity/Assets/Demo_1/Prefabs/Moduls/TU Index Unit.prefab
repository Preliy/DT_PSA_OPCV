  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5236d538fb060b48834286d70f34fa6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: Kinematic axis that raises and lowers the stopper blade.
  - key: Twin
    value: OC Axis on the TS Stopper Typ 1 prefab. Cylinder._limits {0, 20} and axis
      _factor -0.001, so the cylinder's MAX limit puts the blade DOWN and min puts
      it UP.
  - key: Caution
    value: RETRACTED (min, blade up) HOLDS THE PALLET; EXTENDING (max, blade down)
      RELEASES IT. The opposite sense to the FG_01 guard gates. Nine authored entries
      once had this backwards.
  _topologySegment: 
  _topologyParent: {fileID: 0}
