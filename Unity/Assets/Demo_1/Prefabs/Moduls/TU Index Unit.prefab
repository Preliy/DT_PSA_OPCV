  m_Name: 
  m_EditorClassIdentifier: PILAR.Context::PILAR.Context.ContextNode
  _entries:
  - key: Function
    value: The driven belt surface of an index unit - what a pallet actually rides
      on.
  - key: Twin
    value: TransportLinear on a Rigidbody. Moves any rigidbody resting on it by surface
      velocity; it is not a physics conveyor and applies no friction model.
  _topologySegment: 
  _topologyParent: {fileID: 0}
